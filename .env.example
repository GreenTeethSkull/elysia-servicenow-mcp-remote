# Required: ServiceNow instance URL
SERVICENOW_INSTANCE_URL=https://giotst.service-now.com

# Required: OAuth credentials
SERVICENOW_CLIENT_ID=your-client-id
SERVICENOW_CLIENT_SECRET=your-client-secret
SERVICENOW_USERNAME=your-username
SERVICENOW_PASSWORD=your-password

# Optional: ServiceNow API timeout in milliseconds (default: 30000)
SERVICENOW_TIMEOUT=30000

# Optional: Server configuration
PORT=3000
HOST=0.0.0.0

# Optional: CORS origins (comma-separated, * for all)
CORS_ORIGIN=*

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info
